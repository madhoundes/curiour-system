### **6.2 Business Logic Services**
```typescript
// Shipment Service
class ShipmentService {
  async createShipment(data: CreateShipmentData, merchantId: string): Promise<Shipment> {
    // Validate business rules
    await this.validateBusinessRules(data, merchantId);
    
    // Calculate costs
    const costs = await this.calculateShipmentCosts(data);
    
    // Generate tracking number
    const trackingNumber = await this.generateUniqueTrackingNumber();
    
    // Create shipment record
    const shipment = await this.shipmentRepository.create({
      ...data,
      merchantId,
      trackingNumber,
      ...costs,
      status: 'label_created'
    });
    
    // Create initial tracking event
    await this.trackingService.createEvent({
      shipmentId: shipment.id,
      eventType: 'LABEL_CREATED',
      statusAfter: 'label_created',
      actorId: merchantId,
      actorType: 'merchant'
    });
    
    // Send notifications
    await this.notificationService.notifyShipmentCreated(shipment);
    
    return shipment;
  }

  private async validateBusinessRules(data: CreateShipmentData, merchantId: string) {
    // Check merchant status
    const merchant = await this.userService.getUserById(merchantId);
    if (merchant.status !== 'active') {
      throw new Error('Merchant account is not active');
    }
    
    // Check package weight limits
    if (data.package.weight > 100) { // 100 kg limit
      throw new Error('Package weight exceeds maximum limit');
    }
    
    // Check destination restrictions
    const restrictions = await this.getDestinationRestrictions(data.recipient.address);
    if (restrictions.blocked) {
      throw new Error('Destination is not supported');
    }
  }

  private async calculateShipmentCosts(data: CreateShipmentData): Promise<ShipmentCosts> {
    const baseRate = await this.getBaseRate(data.serviceType, data.package.weight);
    const distanceMultiplier = await this.calculateDistanceMultiplier(data);
    const priorityMultiplier = this.getPriorityMultiplier(data.priority);
    const insuranceCost = data.package.insurance ? this.calculateInsuranceCost(data.package.insuranceAmount) : 0;
    
    const baseCost = baseRate * distanceMultiplier * priorityMultiplier;
    const taxAmount = baseCost * 0.13; // 13% HST for Canada
    
    return {
      baseCost,
      insuranceCost,
      taxAmount,
      totalCost: baseCost + insuranceCost + taxAmount
    };
  }
}
