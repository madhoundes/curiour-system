      mockShipmentRepository.create.mockResolvedValue(createMockShipment());
      mockTrackingService.createEvent.mockResolvedValue(createMockTrackingEvent());
      
      // Act
      const result = await shipmentService.createShipment(validData, merchantId);
      
      // Assert
      expect(result).toBeDefined();
      expect(mockShipmentRepository.create).toHaveBeenCalledWith(
        expect.objectContaining({
          merchantId,
          trackingNumber: expect.any(String),
          status: 'label_created'
