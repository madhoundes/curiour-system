// Query Optimization
class ShipmentRepository {
  async getShipmentsWithFilters(filters: ShipmentFilters, pagination: PaginationOptions): Promise<PaginatedShipments> {
    const query = `
      SELECT 
        s.*,
        up_merchant.business_name as merchant_name,
        up_courier.contact_name as courier_name,
        COUNT(te.id) as event_count
      FROM shipments s
      LEFT JOIN user_profiles up_merchant ON s.merchant_id = up_merchant.user_id
      LEFT JOIN user_profiles up_courier ON s.courier_id = up_courier.user_id
      LEFT JOIN tracking_events te ON s.id = te.shipment_id
      WHERE 1=1
        ${filters.status ? 'AND s.status = $1' : ''}
        ${filters.merchantId ? 'AND s.merchant_id = $2' : ''}
        ${filters.dateFrom ? 'AND s.created_at >= $3' : ''}
        ${filters.dateTo ? 'AND s.created_at <= $4' : ''}
      GROUP BY s.id, up_merchant.business_name, up_courier.contact_name
      ORDER BY s.created_at DESC
      LIMIT $5 OFFSET $6
    `;
    
    const params = this.buildQueryParams(filters, pagination);
    const result = await this.db.query(query, params);
    
    return this.formatPaginatedResult(result, pagination);
  }
}
