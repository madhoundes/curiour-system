// Shipment Service Tests
describe('ShipmentService', () => {
  let shipmentService: ShipmentService;
  let mockShipmentRepository: jest.Mocked<ShipmentRepository>;
  let mockTrackingService: jest.Mocked<TrackingService>;

  beforeEach(() => {
